# Copie este arquivo para .env e preencha com os valores do seu projeto
# Supabase (Project Settings → API), ou defina as mesmas variáveis em
# Vercel → Project Settings → Environment Variables.
#
# Use a "Publishable key" (formato novo, sb_publishable_...), não a
# "Secret key" nem a legacy "anon" JWT — projetos criados recentemente
# rejeitam a JWT legada por padrão.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
